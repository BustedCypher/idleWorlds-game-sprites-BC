# already tracking, so these lines only stop FUTURE churn. To get them out of
# the working tree's index as well:
#   git rm -r --cached .codex-tmp .superpowers
# (that keeps the files on disk; history still holds the committed copies).
.codex-tmp/
.superpowers/

